diff --git a/tests/qemuxml2argvmock.c b/tests/qemuxml2argvmock.c
index 9d10b5655f..47ca04bbd1 100644
--- a/tests/qemuxml2argvmock.c
+++ b/tests/qemuxml2argvmock.c
@@ -210,7 +210,7 @@ virNetDevOpenvswitchGetVhostuserIfname(const char *path G_GNUC_UNUSED,
 }
 
 int
-qemuInterfaceOpenVhostNet(virDomainObj *vm G_GNUC_UNUSED,
+qemuInterfaceOpenVhostNet(virDomainObj *vm,
                           virDomainNetDef *net)
 {
     qemuDomainNetworkPrivate *netpriv = QEMU_DOMAIN_NETWORK_PRIVATE(net);
@@ -220,6 +220,11 @@ qemuInterfaceOpenVhostNet(virDomainObj *vm G_GNUC_UNUSED,
     if (!vhostfdSize)
          vhostfdSize = 1;
 
+    if (vm->def->virtType != VIR_DOMAIN_VIRT_KVM ||
+        net->driver.virtio.name == VIR_DOMAIN_NET_DRIVER_TYPE_QEMU) {
+        return 0;
+    }
+
     if (!virDomainNetIsVirtioModel(net))
         return 0;
 
