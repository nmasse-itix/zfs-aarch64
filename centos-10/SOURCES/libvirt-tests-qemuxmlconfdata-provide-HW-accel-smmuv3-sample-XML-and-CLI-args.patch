+        <address domain='0x0000' bus='0x06' slot='0x01' function='0x0'/>
+      </source>
+      <address type='pci' domain='0x0000' bus='0x04' slot='0x00' function='0x0'/>
+    </hostdev>
+    <memballoon model='none'/>
+    <iommu model='smmuv3'>
+      <driver pciBus='1' accel='on'/>
+    </iommu>
+    <iommu model='smmuv3'>
+      <driver pciBus='2' accel='on'/>
+    </iommu>
+  </devices>
+</domain>
